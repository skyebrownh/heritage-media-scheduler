# Copy to .env and fill in. Placeholders only: never commit real values.

# Django's signing key. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

# "true" only for local development. Anything else (or unset) means off.
DEBUG=true

# Comma-separated host names this app answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with https://) allowed to submit forms, e.g. the admin login. Needed in production.
CSRF_TRUSTED_ORIGINS=

# The scheduler's own Postgres, never availability's.
DATABASE_URL=postgres://localhost:5432/heritage_media_scheduler
